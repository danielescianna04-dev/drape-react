---
import Layout from '../layouts/Layout.astro';
import FeatureCard from '../components/FeatureCard.astro';

const features = [
  {
    icon: '🏝️',
    title: 'Island Architecture',
    description: 'Ship zero JavaScript by default. Hydrate only interactive components on demand for unbeatable performance.'
  },
  {
    icon: '🎨',
    title: 'Framework Agnostic',
    description: 'Use React, Vue, Svelte, or Solid components together in the same project. No vendor lock-in.'
  },
  {
    icon: '⚡',
    title: 'Edge Ready',
    description: 'Deploy anywhere — Vercel, Netlify, Cloudflare, or your own server. Optimized for edge computing.'
  },
  {
    icon: '📝',
    title: 'Content First',
    description: 'Built-in content collections with type safety. Perfect for blogs, docs, marketing sites, and portfolios.'
  },
  {
    icon: '🔍',
    title: 'SEO Optimized',
    description: 'Static HTML output with perfect Lighthouse scores. Search engines love Astro sites out of the box.'
  },
  {
    icon: '🛠️',
    title: 'Developer Experience',
    description: 'File-based routing, hot module replacement, and TypeScript support. Develop with confidence and speed.'
  }
];

const stats = [
  { value: '40K+', label: 'GitHub Stars' },
  { value: '0 KB', label: 'Default JS' },
  { value: '100', label: 'Lighthouse Score' },
  { value: '3x', label: 'Faster Builds' }
];
---

<Layout title="AstroApp - Content-First Web Framework">
  <!-- Hero Section -->
  <section class="relative pt-32 pb-20 px-4 overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <div class="absolute top-1/4 left-1/3 w-[500px] h-[500px] bg-primary-600/15 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/4 w-[400px] h-[400px] bg-indigo-600/20 rounded-full blur-3xl"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-blue-600/5 rounded-full blur-3xl"></div>
    </div>

    <div class="absolute inset-0 -z-10 opacity-[0.03]"
         style="background-image: radial-gradient(rgba(255,255,255,.15) 1px, transparent 1px); background-size: 40px 40px;">
    </div>

    <div class="max-w-7xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass text-sm text-primary-300 mb-8">
        <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
        Astro 5 &mdash; Islands architecture reimagined
      </div>

      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight mb-6">
        <span class="block text-white">The web framework for</span>
        <span class="block gradient-text mt-2">content-driven sites</span>
      </h1>

      <p class="max-w-2xl mx-auto text-lg sm:text-xl text-surface-200 mb-10 leading-relaxed">
        Ship fast websites with less JavaScript. Astro's island architecture delivers
        lightning performance while letting you use your favorite UI framework.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
        <button class="btn-primary text-lg !px-10 !py-4">
          Start Your Project
          <svg class="inline-block w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </button>
        <button class="btn-secondary text-lg !px-10 !py-4">
          <svg class="inline-block w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          View on GitHub
        </button>
      </div>

      <!-- Performance showcase -->
      <div class="max-w-3xl mx-auto glass rounded-2xl overflow-hidden">
        <div class="flex items-center gap-2 px-4 py-3 border-b border-white/10">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
          </div>
          <span class="text-xs text-surface-200 ml-2">Lighthouse Report</span>
        </div>
        <div class="p-8 grid grid-cols-4 gap-4">
          {[
            { label: 'Performance', score: 100, color: 'text-green-400' },
            { label: 'Accessibility', score: 100, color: 'text-green-400' },
            { label: 'Best Practices', score: 100, color: 'text-green-400' },
            { label: 'SEO', score: 100, color: 'text-green-400' }
          ].map(item => (
            <div class="text-center">
              <div class={`text-3xl sm:text-4xl font-bold ${item.color} mb-1`}>{item.score}</div>
              <div class="text-xs text-surface-200">{item.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-16 px-4 border-y border-white/5">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
        {stats.map(stat => (
          <div class="text-center">
            <div class="text-3xl sm:text-4xl font-bold gradient-text mb-1">{stat.value}</div>
            <div class="text-sm text-surface-200">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-24 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
          Why developers <span class="gradient-text">love Astro</span>
        </h2>
        <p class="max-w-2xl mx-auto text-surface-200 text-lg">
          The perfect blend of performance, flexibility, and developer experience.
          Build any website, your way.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {features.map(feature => (
          <FeatureCard {...feature} />
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-24 px-4 border-t border-white/5">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
          How <span class="gradient-text">islands</span> work
        </h2>
        <p class="max-w-2xl mx-auto text-surface-200 text-lg">
          Astro renders your pages to static HTML, then selectively hydrates interactive components.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {[
          {
            step: '01',
            title: 'Write Components',
            desc: 'Use any framework — React, Vue, Svelte, Solid, or plain Astro components. Mix and match freely.'
          },
          {
            step: '02',
            title: 'Zero JS Default',
            desc: 'Every page renders to static HTML. No JavaScript is shipped unless you explicitly opt in with client directives.'
          },
          {
            step: '03',
            title: 'Hydrate on Demand',
            desc: 'Add client:load, client:visible, or client:idle to hydrate specific components exactly when needed.'
          }
        ].map(item => (
          <div class="glass rounded-2xl p-8 relative overflow-hidden group hover:bg-white/10 transition-all duration-500">
            <div class="absolute top-4 right-4 text-5xl font-black text-white/5 group-hover:text-primary-500/10 transition-colors duration-500">
              {item.step}
            </div>
            <div class="relative">
              <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-primary-500 to-indigo-600 flex items-center justify-center mb-4">
                <span class="text-white font-bold text-sm">{item.step}</span>
              </div>
              <h3 class="text-xl font-semibold text-white mb-3">{item.title}</h3>
              <p class="text-surface-200 text-sm leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <div class="glass rounded-3xl p-12 relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-primary-600/10 to-indigo-600/10"></div>
        <div class="relative">
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Ship your next site with Astro</h2>
          <p class="text-surface-200 text-lg mb-8 max-w-lg mx-auto">
            Join the growing community of developers building faster, more accessible websites.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <button class="btn-primary text-lg !px-10 !py-4">Get Started Free</button>
            <button class="btn-secondary text-lg !px-10 !py-4">Read the Docs</button>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
