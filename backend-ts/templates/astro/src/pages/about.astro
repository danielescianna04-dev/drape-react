---
import Layout from '../layouts/Layout.astro';

const team = [
  { name: 'Alex Rivera', role: 'CEO & Co-founder', avatar: 'AR' },
  { name: 'Sam Chen', role: 'CTO & Co-founder', avatar: 'SC' },
  { name: 'Jordan Lee', role: 'Head of Design', avatar: 'JL' },
  { name: 'Morgan Davis', role: 'Lead Engineer', avatar: 'MD' }
];

const milestones = [
  { year: '2021', event: 'Project inception and first public release' },
  { year: '2022', event: 'Reached 10,000 GitHub stars and launched v1.0' },
  { year: '2023', event: 'Content Collections, View Transitions, and v3.0' },
  { year: '2024', event: 'Astro 5 with Content Layer and Server Islands' }
];
---

<Layout title="About - AstroApp" description="Learn about the team and mission behind AstroApp.">
  <!-- Hero -->
  <section class="relative pt-32 pb-16 px-4">
    <div class="absolute inset-0 -z-10">
      <div class="absolute top-1/3 left-1/4 w-96 h-96 bg-primary-600/15 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/3 right-1/3 w-96 h-96 bg-indigo-600/15 rounded-full blur-3xl"></div>
    </div>

    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-6">
        <span class="text-white">The story behind </span>
        <span class="gradient-text">AstroApp</span>
      </h1>
      <p class="text-lg sm:text-xl text-surface-200 leading-relaxed max-w-2xl mx-auto">
        We believe the web should be fast by default. Our mission is to help developers
        build content-rich websites that load instantly, everywhere.
      </p>
    </div>
  </section>

  <!-- Mission -->
  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="glass rounded-3xl p-8 md:p-12">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">Our Philosophy</h2>
            <p class="text-surface-200 leading-relaxed mb-4">
              The modern web is bloated. Average page sizes have grown 10x in the last decade,
              yet content sites are sending megabytes of JavaScript for mostly static pages.
              We knew there had to be a better way.
            </p>
            <p class="text-surface-200 leading-relaxed mb-4">
              Astro was born from a simple idea: what if we could build beautiful, interactive
              websites that ship zero JavaScript by default? The island architecture makes this
              possible — render everything to HTML, then hydrate only the interactive bits.
            </p>
            <p class="text-surface-200 leading-relaxed">
              The result? Websites that are faster, more accessible, and better for the planet.
              Performance is not a luxury — it is a right.
            </p>
          </div>
          <div class="relative">
            <div class="aspect-square rounded-2xl bg-gradient-to-br from-primary-500/20 to-indigo-500/20 border border-white/10 flex items-center justify-center">
              <div class="text-center">
                <div class="text-6xl mb-4">🚀</div>
                <div class="text-2xl font-bold gradient-text">Zero JS Default</div>
                <div class="text-surface-200 text-sm mt-1">Performance without compromise</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="py-16 px-4">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-white mb-4">Our Journey</h2>
        <p class="text-surface-200 max-w-xl mx-auto">Key milestones in the AstroApp story.</p>
      </div>
      <div class="space-y-6">
        {milestones.map((m, i) => (
          <div class="glass rounded-2xl p-6 flex items-start gap-6 hover:bg-white/10 transition-all duration-300">
            <div class="flex-shrink-0 w-16 h-16 rounded-xl bg-gradient-to-br from-primary-500 to-indigo-600 flex items-center justify-center">
              <span class="text-white font-bold text-sm">{m.year}</span>
            </div>
            <div class="pt-1">
              <h3 class="text-white font-semibold text-lg">{m.year}</h3>
              <p class="text-surface-200 text-sm mt-1">{m.event}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-white mb-4">Meet the Team</h2>
        <p class="text-surface-200 max-w-xl mx-auto">Passionate people building the future of the web.</p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        {team.map(member => (
          <div class="glass rounded-2xl p-6 text-center group hover:bg-white/10 transition-all duration-500 hover:-translate-y-1">
            <div class="w-20 h-20 rounded-full bg-gradient-to-br from-primary-500 to-indigo-600 flex items-center justify-center mx-auto mb-4
                        group-hover:scale-110 transition-transform duration-500">
              <span class="text-xl font-bold text-white">{member.avatar}</span>
            </div>
            <h3 class="text-white font-semibold">{member.name}</h3>
            <p class="text-surface-200 text-sm mt-1">{member.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <div class="glass rounded-3xl p-12 relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-primary-600/10 to-indigo-600/10"></div>
        <div class="relative">
          <h2 class="text-3xl font-bold text-white mb-4">Want to join the mission?</h2>
          <p class="text-surface-200 text-lg mb-8">We are always looking for talented people who care about web performance.</p>
          <button class="btn-primary text-lg !px-10 !py-4">View Open Positions</button>
        </div>
      </div>
    </div>
  </section>
</Layout>
