FROM node:20-bookworm-slim

# Install essentials
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    bash \
    curl \
    python3 \
    make \
    g++ \
    openssh-client \
    ripgrep \
    ca-certificates \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Reuse existing 'node' user (uid 1000, gid 1000) — rename home to /home/coder
RUN userdel -r node 2>/dev/null; \
    groupadd -g 1000 coder && \
    useradd -u 1000 -g coder -s /bin/bash -m -d /home/coder coder

# Create project directory and cache
RUN mkdir -p /home/coder/project /home/coder/volumes/pnpm-store /data/cache && \
    chown -R coder:coder /home/coder /data/cache

# Install package managers/tools globally.
# Bun is still the default package manager in the backend project detector,
# so it must exist in the workspace image.
RUN npm install -g pnpm@9 serve bun

# Install OpenCode AI agent (MIT license, multi-provider coding agent)
RUN curl -fsSL https://opencode.ai/install | bash && \
    cp /root/.opencode/bin/opencode /usr/local/bin/opencode && \
    chmod +x /usr/local/bin/opencode

# Security: disable automatic postinstall scripts to prevent supply chain attacks
RUN npm config set ignore-scripts true && \
    pnpm config set ignore-scripts true

ENV USE_BUILTIN_RIPGREP=0

# Copy workspace agent
COPY workspace-agent.js /usr/local/bin/workspace-agent.js

# Copy boilerplate templates
COPY templates/ /usr/local/share/drape-templates/
RUN chmod -R 755 /usr/local/share/drape-templates/ && chown -R coder:coder /usr/local/share/drape-templates/

# Copy OpenCode config (auto-accept all tool permissions)
RUN mkdir -p /home/coder/.config/opencode
COPY templates/opencode.json /home/coder/.config/opencode/config.json
RUN chown -R coder:coder /home/coder/.config

WORKDIR /home/coder/project

# Start the workspace agent (port 13338)
CMD ["node", "/usr/local/bin/workspace-agent.js"]
