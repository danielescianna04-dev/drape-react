{
  "name": "drape-backend",
  "version": "2.1.0",
  "description": "Drape AI IDE Backend - TypeScript + Docker Native",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc && cp src/services/*.txt dist/services/ 2>/dev/null || true && mkdir -p dist/services/drape-cloud/sdk && cp src/services/drape-cloud/sdk/drape-cloud.js src/services/drape-cloud/sdk/drape-cloud.d.ts dist/services/drape-cloud/sdk/ && cp src/services/drape-cloud/schema.sql dist/services/drape-cloud/",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.50",
    "@ai-sdk/google": "^3.0.34",
    "@ai-sdk/openai": "^3.0.37",
    "@anthropic-ai/sdk": "^0.68.0",
    "@google/genai": "^1.39.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ai": "^6.0.105",
    "axios": "^1.7.0",
    "bcrypt": "^6.0.0",
    "chokidar": "^4.0.0",
    "cors": "^2.8.5",
    "diff": "^8.0.3",
    "dockerode": "^4.0.9",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.1",
    "fast-glob": "^3.3.0",
    "firebase-admin": "^12.0.0",
    "groq-sdk": "^0.37.0",
    "http-proxy": "^1.18.1",
    "jose": "^5.10.0",
    "jsdom": "^28.1.0",
    "node-cron": "^4.2.1",
    "openai": "^6.18.0",
    "postgres": "^3.4.9",
    "resend": "^6.9.1",
    "turndown": "^7.2.2",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/diff": "^7.0.2",
    "@types/dockerode": "^3.3.31",
    "@types/express": "^4.17.21",
    "@types/http-proxy": "^1.17.15",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.5.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
