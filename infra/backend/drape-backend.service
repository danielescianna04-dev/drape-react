[Unit]
Description=Drape backend v2 (Express + Supabase + Appwrite)
Documentation=https://github.com/danielescianna04-dev/drape-react
After=network.target
Wants=network.target

[Service]
Type=simple
User=drape
Group=drape
WorkingDirectory=/opt/drape/backend-v2
EnvironmentFile=/opt/drape/backend-v2/.env

# Node + npm devono essere nel PATH del service
Environment="PATH=/usr/local/bin:/usr/bin:/bin:/home/drape/.npm-global/bin:/home/drape/.nvm/versions/node/current/bin"
Environment="NODE_ENV=production"

ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5s

# Logging via journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=drape-backend

# Limit resources (CAX31 = 16 GB, lasciamo 4 GB per backend, resto per Appwrite)
MemoryMax=4G
TasksMax=512

# Sicurezza
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/drape/backend-v2
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
