    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "node-appwrite": "^17.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
