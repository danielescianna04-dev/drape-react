NODE_ENV=development
PORT=3000

# Supabase Cloud (Bynot internal)
SUPABASE_URL=https://pfejqyiakkywzdzfoxce.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Appwrite self-hosted (per user DBs)
APPWRITE_ENDPOINT=https://appwrite.bynot.it/v1
APPWRITE_PROJECT_ID=bynot-platform
APPWRITE_API_KEY=

# CORS
CORS_ORIGINS=*

# OpenRouter (used by the direct AI SDK v6 agent path → /agent/run/fast, /agent/v2/chat)
OPENROUTER_API_KEY=

# Project filesystem root for the native agent's tool calls.
# Defaults to /root/projects on the production VPS; override locally.
# BYNOT_PROJECTS_ROOT=/tmp/bynot-projects

# Opencode (legacy bridge — still used by /agent/run/plan, /agent/run/execute, /agent/create)
# OPENCODE_API_URL=
# OPENCODE_API_KEY=
